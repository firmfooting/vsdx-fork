// Renovate dependency automation.
//
// Replaces dependabot (config removed). Conventions this file encodes:
//   - GitHub Actions stay digest-pinned; Renovate raises the pins as PRs.
//   - uv owns resolution: updates land as uv.lock changes, plus a weekly
//     lock-file maintenance pass to keep transitive pins fresh.
//   - One grouped PR per ecosystem, Monday mornings, Australia/Melbourne.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
  ],
  timezone: "Australia/Melbourne",
  schedule: ["before 6am on monday"],
  prConcurrentLimit: 5,
  prHourlyLimit: 0,
  labels: ["dependencies"],
  osvVulnerabilityAlerts: true,
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      description: "GitHub Actions digest bumps: one grouped weekly PR",
      matchFileNames: [".github/workflows/**"],
      groupName: "github-actions",
    },
    {
      description: "Python dependencies and uv lock maintenance: one grouped weekly PR",
      matchFileNames: ["pyproject.toml", "uv.lock"],
      groupName: "python-deps",
    },
  ],
}
